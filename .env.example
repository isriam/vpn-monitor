# ============================================================================
# EMAIL CONFIGURATION (Shared by all monitoring services)
# ============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
FROM_EMAIL=your_email@gmail.com
TO_EMAILS=admin@example.com,backup@example.com

# ============================================================================
# GENERAL MONITORING SETTINGS (Shared by all monitoring services)
# ============================================================================
CHECK_INTERVAL=300              # Seconds between status checks
CONNECTION_TIMEOUT=10           # Connection timeout in seconds
MAX_RETRIES=3                   # Maximum retry attempts
RETRY_DELAY=30                  # Delay between retries in seconds

# ============================================================================
# WIREGUARD MONITORING (wireguard_monitor.py)
# ============================================================================
# WireGuard API Configuration
WG_API_URL=http://localhost:10086/api
WG_API_KEY=your_wireguard_api_key_here
WG_CONFIG_NAME=wg0

# WireGuard Peer Monitoring
# Specify which peers to monitor (comma-separated list of peer names)
MONITORED_PEERS=Work Phone,Home PC
# OR monitor all peers automatically
MONITOR_ALL_PEERS=false

# WireGuard-specific settings
HANDSHAKE_TIMEOUT=600           # Consider peer offline after N seconds without handshake

# ============================================================================
# TAILSCALE MONITORING (tailscale_monitor.py)
# ============================================================================
# Tailscale API Configuration
TAILSCALE_TAILNET=example.com
TAILSCALE_API_KEY=your_tailscale_api_key_here
TAILSCALE_WEBHOOK_KEY=your_tailscale_webhook_key_here

# Tailscale Device Monitoring
# Option 1: Monitor specific devices (comma-separated list)
MONITORED_TAILSCALE_DEVICES=laptop.tailnet.ts.net,phone.tailnet.ts.net,server.tailnet.ts.net
# Option 2: Monitor devices by tags (comma-separated list)
# Tags can be specified with or without the "tag:" prefix
# Example: "kids-devices" or "tag:kids-devices"
# MONITORED_TAILSCALE_TAGS=kids-devices,family
# Option 3: Monitor all devices automatically
# MONITOR_ALL_TAILSCALE_DEVICES=true

# Note: Priority order is: specific devices > tags > all devices
# If MONITORED_TAILSCALE_DEVICES is set, tags and all-devices are ignored
# If MONITORED_TAILSCALE_TAGS is set, all-devices is ignored
