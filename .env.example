# WireGuard API Configuration
WG_API_URL=http://localhost:10086/api
WG_API_KEY=your_wireguard_api_key_here
WG_CONFIG_NAME=wg0

# Tailscale API Configuration
TAILSCALE_TAILNET=example.com
TAILSCALE_API_KEY=your_tailscale_api_key_here

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
FROM_EMAIL=your_email@gmail.com
TO_EMAILS=admin@example.com,backup@example.com

# Peer Monitoring Configuration
# Specify which peers to monitor (comma-separated list of peer names)
# Use the exact names from your WireGuard configuration
MONITORED_PEERS=Work Phone,Home PC
# OR monitor all peers automatically
MONITOR_ALL_PEERS=false

# Tailscale Device Monitoring Configuration
# Specify which devices to monitor (comma-separated list of device names)
# Use the exact names from your Tailscale network
MONITORED_TAILSCALE_DEVICES=laptop,phone,server
# OR monitor all devices automatically
MONITOR_ALL_TAILSCALE_DEVICES=false

# Monitoring Settings (optional - defaults will be used if not specified)
CHECK_INTERVAL=300
CONNECTION_TIMEOUT=10
MAX_RETRIES=3
RETRY_DELAY=30
HANDSHAKE_TIMEOUT=300